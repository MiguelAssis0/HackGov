# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Google API Configuration
GOOGLE_API_KEY=

# Email Configuration (Gmail example)
SPRING_EMAIL_HOST=smtp.gmail.com
SPRING_EMAIL_PORT=587
SPRING_EMAIL=your-email@gmail.com
SPRING_EMAIL_PASSWORD=your-app-password

# Password Expiration (in hours)
PASSWORD_EXPIRE_HOURS=24

# Database Configuration (automatically handled by docker-compose)
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/hackgov_db
# SPRING_DATASOURCE_USERNAME=hackgov_user
# SPRING_DATASOURCE_PASSWORD=hackgov_password

# Frontend API URL (for client-side requests)
VITE_API_URL=http://localhost:8080
